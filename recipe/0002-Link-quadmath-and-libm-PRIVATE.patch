From fd8ec7103d2bb994279b487d0cbf03d8a9c50349 Mon Sep 17 00:00:00 2001
From: "Lori A. Burns" <lburns7@gatech.edu>
Date: Sun, 18 Oct 2026 03:38:29 -0400
Subject: [PATCH] Link quadmath and libm PRIVATE

target_link_libraries(cint quadmath) and target_link_libraries(cint "-lm")
use the plain signature, so the exported cint::cint target lists both in
INTERFACE_LINK_LIBRARIES, and every consumer of find_package(cint) links
them. A shared libcint resolves them itself, so they only get in the way.
On Windows, where conda-forge builds libcint with MinGW gcc, an MSVC-like
consumer (MSVC, clang-cl with lld-link) fails outright: "could not open
'quadmath.lib'", and "-lm" is not an option it knows.

Link both PRIVATE. For a shared libcint, cintTargets.cmake then lists no
link dependencies; for a static one, CMake still passes them on, as
$<LINK_ONLY:...>, since consumers need them there. libm is named as the
library m rather than the flag -lm, so that CMake treats it as a library.
---
 CMakeLists.txt | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index afa6135..25c1a05 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -184,10 +184,12 @@ set_target_properties(cint PROPERTIES
   VERSION ${cint_VERSION}
   SOVERSION ${cint_SOVERSION}
   LIBRARY_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR})
+# PRIVATE: a shared libcint resolves these itself, so consumers of cint::cint
+# shouldn't link them. (A static libcint still passes them on, as LINK_ONLY.)
 if(QUADMATH_FOUND)
-  target_link_libraries(cint quadmath)
+  target_link_libraries(cint PRIVATE quadmath)
 endif()
-target_link_libraries(cint "-lm")
+target_link_libraries(cint PRIVATE m)

 # for consistency between FetchContent / add_subdirectory
 # and find_package, so one can always link to cint::cint.
--
2.43.0
